  @media (max-width: 799px) {
    .dd-actions {
      position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 100%; max-width: 448px; z-index: 30; box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.06);
    }

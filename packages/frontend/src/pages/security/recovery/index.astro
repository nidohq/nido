---
// Recovery settings. The page is a thin shell: the flow lives in
// src/lib/recovery/settingsPage.ts, on the Perch SDK (`perch` namespace of
// @nidohq/passkey-sdk).
import NidoLayout from '../../../layouts/NidoLayout.astro';
import Toast from '../../../components/Toast.astro';
import PasskeySheet from '../../../components/PasskeySheet.astro';
import Icon from '../../../components/Icon.astro';
---
<NidoLayout title="Recovery">
  <div class="col-scroll scroll-hide screen-in">
    <div class="topbar dash-hide-desktop">
      <a href="/security/" class="btn ghost sm" style="width:40px;height:40px;padding:0;border-radius:12px;" aria-label="Back to security">
        <Icon name="back" size={18} />
      </a>
      <div class="disp" style="font-weight:800;font-size:21px;">Recovery settings</div>
    </div>
    <div class="pad" style="padding-top:8px;">
      <div class="dash-head"><h1 class="dash-head-title disp">Recovery settings</h1></div>
      <p class="mut" style="font-size:13.5px;margin:0 0 4px;line-height:1.5;">Who can help you back in, and what they can do.</p>
      <div id="recovery-root"></div>
    </div>
  </div>
  <Toast />
  <PasskeySheet />
</NidoLayout>

<style is:global>
  .pol-fieldset { border: 1px solid var(--line, rgba(0,0,0,0.1)); border-radius: 12px; padding: 12px; display: grid; gap: 8px; }
  .pol-radio, .pol-check { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 500; }
  .pol-input-label { display: grid; gap: 5px; font-size: 12.5px; font-weight: 600; }
</style>

<script>
  import { contractIdFromHostname, isContractId } from '@nidohq/passkey-sdk';
  import { mountRecoverySettings } from '../../../lib/recovery/settingsPage.js';

  const host = contractIdFromHostname(window.location.hostname);
  const account = host && isContractId(host) ? host : null;
  const root = document.getElementById('recovery-root')!;
  await mountRecoverySettings(root, account);
</script>

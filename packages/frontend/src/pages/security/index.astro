---
// Nido reskin of the Security suite hub. Logic (delegation list,
// mountDelegationForm, all IDs and localStorage walking)
// is preserved verbatim from the original BaseLayout version; only the shell,
// markup and copy are reskinned to the Nido "Warm Nest" voice.
import NidoLayout from '../../layouts/NidoLayout.astro';
import Toast from '../../components/Toast.astro';
import PasskeySheet from '../../components/PasskeySheet.astro';
import Icon from '../../components/Icon.astro';
import Nest from '../../components/Nest.astro';
---
<NidoLayout title="Security">
  <div class="col-scroll scroll-hide screen-in">
    <div class="topbar dash-hide-desktop">
      <a href="/account/" class="btn ghost sm" style="width:40px;height:40px;padding:0;border-radius:12px;" aria-label="Back to your Nido">
        <Icon name="back" size={18} />
      </a>
      <div class="disp" style="font-weight:800;font-size:21px;">Keeping you safe</div>
    </div>

    <div class="pad" style="padding-top:8px;">
      <!-- desktop frame header (≥1024); mobile keeps the compact topbar title -->
      <div class="dash-head"><h1 class="dash-head-title disp">Keeping you safe</h1></div>
      <p class="mut" style="font-size:13.5px;margin:0 0 4px;line-height:1.5;">
        The people and devices that can help you get back in.
      </p>

      <!-- Recovery in progress: driven by the controller's activity gate. -->
      <div id="recovery-attempt-banner" class="alert danger" role="alert" hidden style="margin-top:10px;">
        <Icon name="clock" size={18} class="alert-ico" />
        <div style="flex:1;">
          <div id="recovery-attempt-text">A recovery is under way on this Nido.</div>
          <a href="/security/recovery/" style="font-weight:700;">See who can cancel it</a>
        </div>
      </div>

      <div class="card-grid" id="security-grid">
        <!-- ============ Trusted friends (recovery) ============ -->
        <div class="grid-cell">
          <section id="recovery-section">
            <span class="section-label" style="display:block;margin:24px 0 10px;">Recovery</span>
            <div class="card" style="overflow:hidden;padding:0;">
              <a href="/security/recovery/" class="navrow" style="text-decoration:none;color:inherit;border-bottom:none;">
                <div style="width:38px;height:38px;border-radius:11px;background:var(--acc-soft);display:grid;place-items:center;">
                  <Icon name="shieldcheck" size={20} color="var(--acc)" />
                </div>
                <div style="flex:1;">
                  <div style="font-weight:700;font-size:14.5px;">Recovery settings</div>
                  <div id="recovery-summary" class="mut" style="font-size:12.5px;">Friends, a recovery kit, or both</div>
                </div>
                <Icon name="chevron" size={18} color="var(--mut)" />
              </a>
              <a href="/security/recover/" class="navrow" style="text-decoration:none;color:inherit;border-bottom:none;border-top:1px solid var(--line-soft);">
                <div style="flex:1;padding-left:50px;">
                  <div style="font-weight:700;font-size:14px;">Lost your passkey?</div>
                  <div class="mut" style="font-size:12.5px;">Get back in from a new device</div>
                </div>
                <Icon name="chevron" size={18} color="var(--mut)" />
              </a>
            </div>
          </section>
        </div>

        <!-- ============ Apps you've let in (delegation) ============ -->
        <div class="grid-cell">
          <section id="delegations-section">
            <span class="section-label" style="display:block;margin:24px 0 10px;">Apps you've let in</span>
            <div class="card" style="padding:18px;">
              <p class="mut" style="font-size:13px;margin:0 0 14px;line-height:1.55;">
                Apps you let act on your behalf for a while. You can cut them off any time.
              </p>
              <!-- No "Let in an app" button: apps are let in via the dApp's own
                   connect/delegate flow, never user-initiated from here. This
                   card only lists (and revokes) what's already been granted. -->
              <div id="delegation-list"></div>
            </div>
          </section>
        </div>

        <!-- ============ This device ============ -->
        <div class="grid-cell">
          <section id="advanced-section">
            <span class="section-label" style="display:block;margin:24px 0 10px;">This device</span>
            <div class="card" style="overflow:hidden;padding:0;">
              <div class="navrow" style="cursor:default;border-bottom:none;">
                <div style="width:38px;height:38px;border-radius:11px;background:var(--good-soft);display:grid;place-items:center;">
                  <Icon name="key" size={20} color="var(--good)" />
                </div>
                <div style="flex:1;">
                  <div style="font-weight:700;font-size:14.5px;">Your passkey on this device</div>
                  <div id="passkey-status-sub" class="mut" style="font-size:12.5px;">You're the only one who gets in</div>
                </div>
                <span id="passkey-status-chip" class="chip mut" style="font-size:11px;">…</span>
              </div>
              <div id="device-details" hidden style="border-top:1px solid var(--line-soft);padding:14px 16px;">
                <div class="mut" style="font-size:12px;font-weight:700;margin-bottom:4px;">Public key</div>
                <code id="device-pubkey" class="mono" style="font-size:11.5px;word-break:break-all;display:block;"></code>
                <div class="mut" style="font-size:12px;font-weight:700;margin:12px 0 4px;">Credential ID</div>
                <code id="device-cred-id" class="mono" style="font-size:11.5px;word-break:break-all;display:block;"></code>
                <div class="mut" style="font-size:12px;font-weight:700;margin:12px 0 4px;">Bound to</div>
                <code id="device-rp-id" class="mono" style="font-size:11.5px;word-break:break-all;display:block;"></code>
                <p class="mut" style="font-size:12px;line-height:1.5;margin:12px 0 0;">
                  Your passkey is bound to this Nido's own subdomain — it can't approve anything on another account.
                </p>
              </div>
            </div>
          </section>
        </div>

        <!-- ============ Account policy (full inspector + builder) ============ -->
        <div class="grid-cell">
          <section id="policy-link-section">
            <span class="section-label" style="display:block;margin:24px 0 10px;">Account policy</span>
            <div class="card" style="overflow:hidden;padding:0;">
              <a href="/account/policy/" class="navrow" style="text-decoration:none;color:inherit;border-bottom:none;">
                <div style="width:38px;height:38px;border-radius:11px;background:var(--acc-soft);display:grid;place-items:center;">
                  <Icon name="shieldcheck" size={20} color="var(--acc)" />
                </div>
                <div style="flex:1;">
                  <div style="font-weight:700;font-size:14.5px;">Account policy</div>
                  <div class="mut" style="font-size:12.5px;">
                    Every rule on this account — the applied policy document, session keys, and admin keys.
                  </div>
                </div>
                <Icon name="chevron" size={18} color="var(--mut)" />
              </a>
            </div>
          </section>
        </div>
      </div>

      <div style="display:flex;justify-content:center;margin-top:28px;">
        <Nest size={28} />
      </div>
      <div class="mut" style="text-align:center;font-size:12px;margin-top:10px;">
        Nido · A safe place for everything
      </div>
    </div>
  </div>

  <Toast />
  <PasskeySheet />
</NidoLayout>

<script>
  import { rpc, Contract, scValToNative } from '@stellar/stellar-sdk';
  import {
    contractIdFromHostname,
    nameFromHostname,
    isContractId,
    resolveNameCached,
    stripSubdomain,
    accountUrl,
    loadCredential,
    buf2base64url,
    perch,
  } from '@nidohq/passkey-sdk';
  import { RPC_URL, NETWORK_PASSPHRASE } from '../../lib/network.js';
  import { fetchRegistryAddress } from '../../lib/policyChainFetch.js';
  import { renderAppCard } from '../../components/AppScopeCard.js';
  import { appEntries, olderAppPermissions } from '../../lib/policy/appScopes.js';
  import { cleanUpRequest, removeAppRequest } from '../../lib/policy/appActions.js';
  import { accountScopes, loadScopeChecks } from '../../lib/policy/appGrantLoad.js';
  import { stashSignRequest } from '../../lib/signing/signRequest.js';
  import { perchDeployment } from '../../lib/recovery/deployment.js';
  import { readRecoveryState } from '../../lib/recovery/chain.js';
  import { MODE_TEXT, PROFILE_TEXT } from '../../lib/recovery/model.js';

  let account = contractIdFromHostname(window.location.hostname);

  // Name subdomain → resolve the name and redirect to the contract-id
  // subdomain. Every security action signs in-page (signAndSubmit binds the
  // passkey ceremony to window.location.hostname) and the device passkey lives
  // on the contract-id subdomain, so the whole page must run there — mirrors
  // /transfer/ and /account/ signing. NOTE: contractIdFromHostname does no
  // strkey validation, so on a name subdomain (e.g. `qqqaa.nido.fyi`) it
  // returns "QQQAA", an invalid contract id — hence the resolve-or-null below.
  {
    const detectedName = nameFromHostname(window.location.hostname);
    if (detectedName && !isContractId(detectedName)) {
      account = null;
      try {
        const resolved = await resolveNameCached(
          RPC_URL,
          await fetchRegistryAddress('name-registry'),
          detectedName,
          NETWORK_PASSPHRASE,
        );
        if (resolved) {
          const rootHost = stripSubdomain(window.location.host);
          const target = accountUrl(rootHost, resolved, window.location.pathname + window.location.search);
          window.location.replace(window.location.protocol + target);
          throw new Error('redirecting');
        }
        // Unregistered name: leave account null so the guidance branch renders.
      } catch (err) {
        if (err instanceof Error && err.message === 'redirecting') throw err;
        // Registry unreachable: leave account null; guidance branch renders.
      }
    }
  }

  // Passkey details for this device (relocated here from the account page).
  const deviceCred = account ? loadCredential(account) : null;
  const chip = document.getElementById('passkey-status-chip') as HTMLElement | null;
  const sub = document.getElementById('passkey-status-sub') as HTMLElement | null;
  if (deviceCred) {
    if (chip) { chip.className = 'chip good'; chip.textContent = 'On'; }
    if (sub) { sub.hidden = false; }
    (document.getElementById('device-details') as HTMLElement).hidden = false;
    document.getElementById('device-pubkey')!.textContent = deviceCred.publicKey;
    document.getElementById('device-cred-id')!.textContent = buf2base64url(deviceCred.credentialId);
    document.getElementById('device-rp-id')!.textContent = window.location.hostname;
  } else {
    if (chip) { chip.className = 'chip warn'; chip.textContent = 'Not set up'; }
    if (sub) { sub.hidden = true; }
  }

  const delegationList = document.getElementById('delegation-list')!;

  if (!account) {
    delegationList.innerHTML =
      '<p class="mut" style="font-size:13px;">Open this page from your account to manage who can help you.</p>';
  } else {
    // S-02: shared skeleton placeholder instead of a bare "Loading…" string.
    delegationList.innerHTML =
      '<div class="skeleton" style="height:46px; margin-bottom:10px;"></div><div class="skeleton" style="height:46px;"></div>';
    // One card per connected app: its origin's scoped document. App
    // permissions still in the admin document from before apps had their
    // own are listed (with Remove) on the Policy page.
    try {
      const [{ scopes }, checks] = await Promise.all([perch.readScopes(accountScopes(account)), loadScopeChecks(account)]);
      const toSign = (req: Parameters<typeof stashSignRequest>[0]) => {
        window.location.href = `/sign/?req=${stashSignRequest(req)}`;
      };
      const acct = account;
      delegationList.replaceChildren(
        ...appEntries(scopes).map((app) =>
          renderAppCard(app, {
            onRemoveApp: (a) => {
              if (confirm(`Remove ${a.origin ?? 'this app'}? Every permission it holds on this account ends now.`)) {
                toSign(removeAppRequest(acct, a, '/security/'));
              }
            },
            onCleanUp: (a) => toSign(cleanUpRequest(acct, a, '/security/')),
          }),
        ),
      );
      const older = checks.admin ? olderAppPermissions(checks.admin.doc, checks.excluded, scopes).length : 0;
      if (older > 0) {
        const note = document.createElement('p');
        note.className = 'mut';
        note.style.cssText = 'font-size:13px;';
        note.innerHTML =
          `${older} older app permission${older === 1 ? ' is' : 's are'} still in your account's own rules. ` +
          '<a class="link" href="/account/policy/">Review them on your Policy page</a>.';
        delegationList.append(note);
      }
      if (!delegationList.children.length) {
        delegationList.innerHTML = '<p class="mut" style="font-size:13px;">No apps have been let in yet.</p>';
      }
    } catch (e) {
      const msg = e instanceof Error ? e.message : String(e);
      delegationList.innerHTML = `<p class="mut" style="font-size:13px;">Couldn't load: ${msg}</p>`;
    }

    // Recovery summary + in-progress banner. Best-effort: a failure here must
    // never break the rest of the Security page.
    void renderRecoverySummary(account);
  }

  /** The recovery card's one-line summary, and the banner while an attempt
   *  is authorized. */
  async function renderRecoverySummary(acc: string): Promise<void> {
    const summaryEl = document.getElementById('recovery-summary')!;
    if (!perchDeployment()) {
      summaryEl.textContent = 'Not available on this network yet';
      return;
    }
    try {
      const state = await readRecoveryState(acc);
      if (!state.summary) {
        summaryEl.textContent = 'Off: set it up so you never get locked out';
        return;
      }
      summaryEl.textContent = `${PROFILE_TEXT[state.summary.profile].title}. ${MODE_TEXT[state.summary.mode]}.`;
      if (state.gate?.authorized_attempt != null) {
        const banner = document.getElementById('recovery-attempt-banner')!;
        document.getElementById('recovery-attempt-text')!.textContent = state.gate.frozen
          ? 'A recovery was approved. This Nido is frozen until it finishes or is cancelled.'
          : 'A recovery was approved and is waiting out its delay.';
        banner.hidden = false;
      }
    } catch {
      summaryEl.textContent = "Couldn't read recovery right now";
    }
  }

</script>

<style>
  section { margin: 0; }

  /* The recovery/delegation cards and the forms injected by the preserved
     lib mounters (recoveryForm.ts / delegationForm.ts / MultisigRecoveryCard.ts)
     emit their own plain markup; give it a Nido-flavoured skin without touching
     those files. */
  .nido-form { margin-top: 14px; }
  .nido-form :global(h3) {
    font-family: var(--disp); font-weight: 800; font-size: 16px;
    margin: 0 0 6px;
  }
  .nido-form :global(.muted),
  :global(.rule-card .muted) { color: var(--mut); font-size: 12.5px; }
  .nido-form :global(label) {
    font-size: 12.5px; font-weight: 700; color: var(--ink-soft);
  }
  .nido-form :global(input),
  .nido-form :global(select),
  .nido-form :global(textarea) {
    font-family: var(--body); font-size: 14px; color: var(--ink);
    border: 1px solid var(--line); border-radius: var(--r-sm);
    padding: 9px 12px; background: var(--paper-2); outline: none;
  }
  .nido-form :global(input:focus),
  .nido-form :global(select:focus),
  .nido-form :global(textarea:focus) {
    border-color: var(--acc); box-shadow: 0 0 0 3px var(--acc-soft);
  }
  .nido-form :global(button),
  :global(.rule-card .actions button),
  :global(.rule-card .actions a) {
    font-family: var(--body); font-weight: 700; font-size: 13.5px;
    border-radius: var(--r-sm); border: 1px solid var(--line);
    background: var(--chip); color: var(--ink); padding: 8px 14px;
    cursor: pointer; text-decoration: none; display: inline-flex; align-items: center;
  }
  .nido-form :global(.actions) { display: flex; gap: 10px; flex-wrap: wrap; }

  /* Rule cards (recovery + session key) */
  :global(.rule-card) {
    background: var(--paper-3); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 14px; margin-bottom: 10px;
  }
  :global(.rule-card strong) { font-weight: 700; font-size: 14.5px; }
  :global(.rule-card .chips) { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  :global(.rule-card .actions) { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
  :global(.rule-card .small) { font-size: 12px; }

  /* Session-key scope line (injected via innerHTML — must be :global). */
  :global(.rule-card .scope-line) { margin: 8px 0 0; line-height: 1.5; }
  :global(.rule-card .scope-line .contract-link) {
    color: var(--acc); font-size: 11.5px; text-decoration: underline;
    text-underline-offset: 2px; word-break: break-all;
  }
  :global(.rule-card .revoke[disabled]) { opacity: 0.55; cursor: default; }
</style>

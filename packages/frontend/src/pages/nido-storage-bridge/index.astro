<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Nido storage bridge</title>
  </head>
  <body>
    <script>
      import { answerBridgeRequest } from "../../lib/nidoSharedStorage";

      // Served framed by account and name origins only (see the route's
      // frame-ancestors header); a request must come from the embedding window.
      window.addEventListener("message", (event: MessageEvent) => {
        const response = answerBridgeRequest(
          {
            origin: event.origin,
            data: event.data,
            fromParent: window.parent !== window && event.source === window.parent,
          },
          window.location.host,
        );
        if (response) window.parent.postMessage(response, event.origin);
      });
    </script>
  </body>
</html>

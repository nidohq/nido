                then
                  ok (core.result.Result.Err authority.Refusal.InvalidNewKey)
                else
                  let b7 ←
                    authority.Key.Insts.CoreCmpPartialEqKey.eq request.new_key
                      a.roles.fee
                  if b7
                  then
                    ok (core.result.Result.Err authority.Refusal.InvalidNewKey)
                  else
                    let i := alloc.vec.Vec.len request.operations
                    if i != 2#usize
                    then
                      ok (core.result.Result.Err
                        authority.Refusal.InvalidOperations)
                    else
                      let o ←
                        alloc.vec.Vec.index
                          (core.slice.index.SliceIndexUsizeSlice
                          authority.Operation) request.operations 0#usize
                      let b8 := core.option.Option.is_some o.source
                      if b8
                      then
                        ok (core.result.Result.Err
                          authority.Refusal.InvalidOperations)
                      else
                        let o1 ←
                          alloc.vec.Vec.index
                            (core.slice.index.SliceIndexUsizeSlice
                            authority.Operation) request.operations 1#usize
                        let b9 := core.option.Option.is_some o1.source
                        if b9
                        then
                          ok (core.result.Result.Err
                            authority.Refusal.InvalidOperations)
                        else
                          let b10 ←
                            core.cmp.PartialEq.ne.trait_default
                              authority.OperationBody.Insts.CoreCmpPartialEqOperationBody
                              o.body (authority.OperationBody.SetSigner
                              { key := request.new_key, weight })
                          if b10
                          then
                            ok (core.result.Result.Err
                              authority.Refusal.InvalidOperations)
                          else
                            let b11 ←
                              core.cmp.PartialEq.ne.trait_default
                                authority.OperationBody.Insts.CoreCmpPartialEqOperationBody
                                o1.body (authority.OperationBody.SetSigner
                                { key := old_key, weight := 0#u8 })
                            if b11
                            then
                              ok (core.result.Result.Err
                                authority.Refusal.InvalidOperations)
                            else
                              let approved ←
                                match rk with
                                | authority.RotationKind.ReplaceLocal =>
                                  authority.contains_key evidence a.roles.local
                                | authority.RotationKind.RecoverLocal =>
                                  do
                                  let b12 ←
                                    authority.contains_key evidence
                                      a.roles.service
                                  if b12
                                  then
                                    authority.contains_key evidence
                                      a.roles.recovery
                                  else ok false
                                | authority.RotationKind.ReplaceService =>
                                  authority.contains_key evidence a.roles.local
                                | authority.RotationKind.ReplaceRecovery =>
                                  authority.contains_key evidence a.roles.local
                              if approved
                              then
                                let next ←
                                  authority.Authority.Insts.CoreCloneClone.clone
                                    a
                                let (k, k1, k2) ←
                                  match rk with
                                  | authority.RotationKind.ReplaceLocal =>
                                    ok (request.new_key, next.roles.service,
                                      next.roles.recovery)
                                  | authority.RotationKind.RecoverLocal =>
                                    ok (request.new_key, next.roles.service,
                                      next.roles.recovery)
                                  | authority.RotationKind.ReplaceService =>
                                    ok (next.roles.local, request.new_key,
                                      next.roles.recovery)
                                  | authority.RotationKind.ReplaceRecovery =>
                                    ok (next.roles.local, next.roles.service,
                                      request.new_key)
                                let v ←
                                  authority.rotate_loop old_key weight
                                    request.new_key next.signers 0#usize
                                let r1 ←
                                  authority.validate
                                    {
                                      next
                                        with
                                        roles :=
                                          {
                                            next.roles
                                              with
                                              «local» := k,
                                              service := k1,
                                              recovery := k2
                                          },
                                        signers := v
                                    }
                                let cf1 ←
                                  core.result.Result.Insts.CoreOpsTry.branch r1
                                match cf1 with
                                | core.ops.control_flow.ControlFlow.Continue _
                                  =>
                                  ok (core.result.Result.Ok
                                    {
                                      next
                                        with
                                        roles :=
                                          {
                                            next.roles
                                              with
                                              «local» := k,
                                              service := k1,
                                              recovery := k2
                                          },
                                        signers := v
                                    })
                                | core.ops.control_flow.ControlFlow.Break
                                  residual =>
                                  core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                                    authority.Authority (core.convert.FromSame
                                    authority.Refusal) residual
                              else
                                ok (core.result.Result.Err
                                  authority.Refusal.InsufficientEvidence)
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
      authority.Authority (core.convert.FromSame authority.Refusal) residual

end g_account_core
